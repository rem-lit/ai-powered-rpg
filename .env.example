# Copier ce fichier en .env (jamais commité) et le compléter.
ANTHROPIC_API_KEY=

# Modèle Claude du MJ (question ouverte : qualité narrative contre coût par tour).
# Exemples : claude-opus-5-5 (meilleure plume), claude-sonnet-5-5 (moins cher).
MJ_MODEL=claude-opus-5-5

# Facultatif : effort de réflexion (low, medium, high, xhigh, max).
# Vide = valeur par défaut du modèle.
MJ_EFFORT=
